NODE_ENV=production
HOST=0.0.0.0
PORT=8050

# Nuxt Auth
AUTH_SECRET="chaoxing-sign"
AUTH_ORIGIN="http://localhost:8050"
NEXTAUTH_URL="http://localhost:8050"

# Prisma
DATABASE_URL="postgresql://username:password@localhost:5432/chaoxing"

# APP
NUXT_IM_INIT_CONNECT=false # 启动时是否自动重连
# 网页账户注册：改成 true 并重启后开放 5 分钟，到期自动写回 false
ALLOW_WEB_REGISTRATION=false
# 学习通 HTTP/HTTPS 代理；留空直连，修改后重启生效
# 示例：http://127.0.0.1:7890 或 http://user:password@proxy.example:8080
CX_PROXY_URL=

# 国内默认百度地图；只有明确设置 osm 才启用 OSM/Photon（不自动回退）
MAP_PROVIDER=baidu
# 百度浏览器端 AK：开启 JavaScript API，Referer 白名单限制为本站域名/IP
# 此 AK 用于浏览器 SDK，会发送到前端；不要填服务端 AK
BAIDU_MAP_BROWSER_AK=
# 百度服务端 AK：开启地点检索、地理编码和全球逆地理编码，限制服务器出口 IP
BAIDU_MAP_SERVER_AK=
# 仅 MAP_PROVIDER=osm 时生效；国内部署无需配置，公共实例无可用性保证
MAP_PHOTON_ENDPOINT=https://photon.komoot.io/api/
